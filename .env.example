# Copie para .env (ignorado pelo git) e ajuste se precisar.
POSTGRES_DB=momentos
POSTGRES_USER=momentos
POSTGRES_PASSWORD=momentos
# 5433 evita conflito com um PostgreSQL instalado direto na máquina
POSTGRES_PORT=5433

# Armazenamento: "local" (disco, padrão em desenvolvimento) ou "s3"
MOMENTOS_STORAGE_TYPE=local
MOMENTOS_STORAGE_LOCAL_PATH=./storage
# Para MOMENTOS_STORAGE_TYPE=s3 (qualquer serviço compatível: R2, Backblaze, AWS, Wasabi)
#MOMENTOS_S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com
#MOMENTOS_S3_REGION=auto
#MOMENTOS_S3_BUCKET=momentos
#MOMENTOS_S3_ACCESS_KEY=
#MOMENTOS_S3_SECRET_KEY=

MOMENTOS_PORT=8080
# Limites de upload (configuráveis; vídeos grandes exigem aumentar os dois)
MOMENTOS_MAX_FILE_SIZE=200MB
MOMENTOS_MAX_REQUEST_SIZE=600MB
