# Copie para .env (ignorado pelo git) e ajuste se precisar.
POSTGRES_DB=momentos
POSTGRES_USER=momentos
POSTGRES_PASSWORD=momentos
# 5433 evita conflito com um PostgreSQL instalado direto na máquina
POSTGRES_PORT=5433

MINIO_ROOT_USER=momentos
MINIO_ROOT_PASSWORD=momentos123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

MOMENTOS_PORT=8080
# Limites de upload (configuráveis; vídeos grandes exigem aumentar os dois)
MOMENTOS_MAX_FILE_SIZE=200MB
MOMENTOS_MAX_REQUEST_SIZE=600MB
